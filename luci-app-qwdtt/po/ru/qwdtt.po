msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Project-Id-Version: luci-app-qwdtt\n"
"Language: ru\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "not a VK call link or a hash"
msgstr "не ссылка на звонок VK и не хеш"

msgid "expected %d characters, got %d"
msgstr "ожидается символов: %d, получено: %d"

msgid "unexpected character \"%s\""
msgstr "недопустимый символ \"%s\""

msgid "line %d: %s"
msgstr "строка %d: %s"

msgid "At least one hash is required."
msgstr "Требуется хотя бы один хеш."

msgid "%d hash(es) staged. Use Save & Apply to write them and reload the client."
msgstr "Подготовлено хешей: %d. Нажмите \"Сохранить и применить\", чтобы записать их и перезапустить клиент."

msgid "Import hashes"
msgstr "Импорт хешей"

msgid "One per line, and the box starts from the current list so existing entries are kept unless you remove them. A full VK call link may be pasted and is reduced to its hash; commas and semicolons separate too, and duplicates are dropped."
msgstr "По одному в строке. Поле заполнено текущим списком, поэтому существующие записи сохранятся, если их не удалить. Можно вставить полную ссылку на звонок VK -- она будет приведена к хешу; запятые и точки с запятой тоже разделяют значения, дубликаты отбрасываются."

msgid "Dismiss"
msgstr "Отмена"

msgid "Save"
msgstr "Сохранить"

msgid "Asking VK about each configured hash. This uses the network and can take several seconds per hash."
msgstr "Проверка каждого заданного хеша в VK. Используется сеть, на каждый хеш может уйти несколько секунд."

msgid "Check hashes"
msgstr "Проверка хешей"

msgid "Close"
msgstr "Закрыть"

msgid "Check failed (exit %d)"
msgstr "Проверка не удалась (код выхода %d)"

msgid "No output."
msgstr "Нет вывода."

msgid "Check failed:"
msgstr "Проверка не удалась:"

msgid "exit %d"
msgstr "код выхода %d"

msgid "Uptime"
msgstr "Время работы"

msgid "MAC"
msgstr "MAC"

msgid "RX"
msgstr "RX"

msgid "Pkts."
msgstr "пакетов"

msgid "TX"
msgstr "TX"

msgid "IPv4"
msgstr "IPv4"

msgid "connecting"
msgstr "подключается"

msgid "Information"
msgstr "Информация"

msgid "Interface disabled"
msgstr "Интерфейс отключен"

msgid "stopped"
msgstr "остановлен"

msgid "Error"
msgstr "Ошибка"

msgid "%s failed (exit %d)"
msgstr "%s не удалось (код выхода %d)"

msgid "qWDTT"
msgstr "qWDTT"

msgid "Running %s..."
msgstr "Выполняется %s..."

msgid "%s failed: %s"
msgstr "%s не удалось: %s"

msgid "Status"
msgstr "Состояние"

msgid "Enabled"
msgstr "Включено"

msgid "yes"
msgstr "да"

msgid "no"
msgstr "нет"

msgid "One tunnel per section, all running at once. The name is the TUN device the tunnel creates. A second tunnel needs its own routing table and a firewall mark to say which traffic it carries: the tunnel without a mark takes everything arriving from the LAN."
msgstr "Один туннель на секцию, все работают одновременно. Имя секции - это имя TUN-устройства, которое поднимет туннель. Второму туннелю нужны своя таблица маршрутизации и метка межсетевого экрана, определяющая, какой трафик он несет: туннель без метки забирает весь трафик из локальной сети."

msgid "Add tunnel..."
msgstr "Добавить туннель..."

msgid "Tunnel"
msgstr "Туннель"

msgid "Peer"
msgstr "Сервер"

msgid "Edit"
msgstr "Изменить"

msgid "Restart this tunnel"
msgstr "Перезапустить этот туннель"

msgid "Restart"
msgstr "Перезапустить"

msgid "Stop this tunnel until it is started again or the router reboots"
msgstr "Остановить этот туннель до следующего запуска или перезагрузки"

msgid "Stop"
msgstr "Остановить"

msgid "Name"
msgstr "Имя"

msgid "New tunnel name"
msgstr "Имя нового туннеля"

msgid "Also the name of the TUN device this tunnel creates, so at most 15 characters. Keep the qwdtt prefix and the firewall zone covers it: the zone matches qwdtt+, and any other name has to be added to it by hand."
msgstr "Оно же имя TUN-устройства, которое поднимет туннель, поэтому не длиннее 15 символов. Сохраните префикс qwdtt: зона qwdtt в межсетевом экране принимает устройства по шаблону qwdtt+, а имя с другим началом придется добавить в зону вручную."

msgid "That name is already taken"
msgstr "Это имя уже занято"

msgid "That name is too long for an interface"
msgstr "Это имя слишком длинное для интерфейса"

msgid "Add tunnel"
msgstr "Добавить туннель"

msgid "Cancel"
msgstr "Отмена"

msgid "Loading data..."
msgstr "Загрузка данных..."

msgid "Create tunnel"
msgstr "Создать туннель"

msgid "General"
msgstr "Основное"

msgid "Advanced"
msgstr "Дополнительно"

msgid "Routing"
msgstr "Маршрутизация"

msgid "Logs"
msgstr "Журнал"

msgid "Start at boot and run now."
msgstr "Запускать при загрузке и запустить сейчас."

msgid "Mode"
msgstr "Режим"

msgid "rawtun creates the TUN interface this router uses. The client has other modes, which this package does not configure."
msgstr "rawtun создает интерфейс TUN, который использует этот роутер. У клиента есть и другие режимы, но этот пакет их не настраивает."

msgid "Peer host"
msgstr "Адрес сервера"

msgid "Server hostname or IP address."
msgstr "Имя хоста или IP-адрес сервера."

msgid "Peer port"
msgstr "Порт сервера"

msgid "UDP port of the server RAW listener, usually 56003."
msgstr "UDP-порт RAW-слушателя на сервере, обычно 56003."

msgid "Password"
msgstr "Пароль"

msgid "Connection password, as set on the server."
msgstr "Пароль подключения, заданный на сервере."

msgid "Device ID"
msgstr "Идентификатор устройства"

msgid "Identifies this client to the peer. It must be unique: two tunnels sharing one are the same device to the server, and each disconnects the other."
msgstr "Идентифицирует этот клиент на сервере. Должен быть уникальным: два туннеля с одинаковым идентификатором для сервера - одно устройство, и они отключают друг друга."

msgid "Hashes"
msgstr "Хеши"

msgid "One field per hash, %d characters each. A VK call link may be pasted into a field and is reduced to its hash when saved. Import takes several at once; Check asks VK whether each saved hash still resolves. At least one is required -- the client selects a hash modulo the list length, so an empty list cannot work."
msgstr "По одному полю на хеш, символов в каждом: %d. В поле можно вставить ссылку на звонок VK -- при сохранении она будет приведена к хешу. \"Импорт\" принимает сразу несколько, \"Проверить\" спрашивает у VK, действителен ли еще каждый сохраненный хеш. Нужен хотя бы один: клиент выбирает хеш по остатку от деления на длину списка, поэтому пустой список работать не может."

msgid "Paste several hashes or VK call links at once"
msgstr "Вставить сразу несколько хешей или ссылок на звонки VK"

msgid "Import"
msgstr "Импорт"

msgid "Contacts VK. Uses the saved config, so staged edits are not included."
msgstr "Обращается к VK. Использует сохраненную конфигурацию, непримененные изменения не учитываются."

msgid "Check"
msgstr "Проверить"

msgid "LAN interface"
msgstr "Интерфейс LAN"

msgid "LAN interface, for example: br-lan."
msgstr "Интерфейс локальной сети, например: br-lan."

msgid "Firewall mark"
msgstr "Метка межсетевого экрана"

msgid "Optional. Traffic carrying this mark is routed into this tunnel; set the mark yourself under Network -> Firewall, with target \"mark\", a source zone and destination \"any\". Value or value/mask, hex starting with 0x. Left empty, this tunnel takes everything arriving from the LAN, and only one tunnel may do that."
msgstr "Необязательно. Трафик с этой меткой направляется в этот туннель; саму метку задайте в разделе Сеть -> Межсетевой экран правилом с целью \"mark\", исходной зоной и назначением \"any\". Значение или значение/маска, шестнадцатеричное - с 0x в начале. Если оставить пустым, туннель забирает весь трафик из локальной сети, и так может делать только один туннель."

msgid "%s already takes everything arriving from the LAN, so this tunnel needs a mark"
msgstr "%s уже забирает весь трафик из локальной сети, поэтому этому туннелю нужна метка"

msgid "Routing table"
msgstr "Таблица маршрутизации"

msgid "Table the default route into this tunnel is written to. Unique per tunnel."
msgstr "Таблица, в которую записывается маршрут по умолчанию через этот туннель. Уникальная для каждого туннеля."

msgid "Table %s is already used by %s"
msgstr "Таблицу %s уже занимает %s"

msgid "Rule priority"
msgstr "Приоритет правила"

msgid "Priority of the ip rule that selects the table above. Unique per tunnel, and lower than the priority of the tunnel without a mark, or that one answers first and this tunnel never sees a packet."
msgstr "Приоритет правила ip, которое выбирает таблицу выше. Уникальный для каждого туннеля и меньше приоритета туннеля без метки, иначе тот сработает первым и сюда не попадет ни один пакет."

msgid "Priority %s is already used by %s"
msgstr "Приоритет %s уже занимает %s"

msgid "Must be below %d, the priority of %s, which has no mark"
msgstr "Должен быть меньше %d - приоритета туннеля %s, у которого нет метки"

msgid "Workers"
msgstr "Воркеры"

msgid "Number of parallel sessions. Every tunnel runs its own, so two tunnels cost twice this."
msgstr "Число параллельных сессий. У каждого туннеля свои, поэтому два туннеля стоят вдвое дороже."

msgid "DNS"
msgstr "DNS"

msgid "DNS resolver for VK: yandex, cloudflare or google, their doh- variants, or custom:IP and doh:URL."
msgstr "DNS-резолвер для VK: yandex, cloudflare или google, их doh-варианты, либо custom:IP и doh:URL."

msgid "Obfuscation"
msgstr "Обфускация"

msgid "Obfuscation mode: audio or video."
msgstr "Режим обфускации: audio или video."

msgid "Captcha mode"
msgstr "Режим капчи"

msgid "Captcha bypass mode: auto, wv or rjs."
msgstr "Режим обхода капчи: auto, wv или rjs."

msgid "VK auth"
msgstr "Авторизация VK"

msgid "VK authorization mode: account or anonymous."
msgstr "Режим авторизации VK: account или anonymous."

msgid "VK anonymous path"
msgstr "Анонимный путь VK"

msgid "Anonymous VK TURN path: vkcalls or legacy."
msgstr "Путь анонимного доступа к VK TURN: vkcalls или legacy."

msgid "Disable DTLS"
msgstr "Отключить DTLS"

msgid "Direct mode: RTP-obfs AEAD over TURN without DTLS. The server has to be started with -listen-direct, or the tunnel will not come up."
msgstr "Прямой режим: RTP-obfs AEAD поверх TURN без DTLS. Сервер должен быть запущен с -listen-direct, иначе туннель не поднимется."

msgid "TURN over TCP"
msgstr "TURN через TCP"

msgid "Reach the TURN relay over TCP instead of UDP. Works around UDP throttling on some networks, for example Rostelecom."
msgstr "Подключаться к TURN по TCP вместо UDP. Обходит ограничение UDP в некоторых сетях, например у Ростелекома."

msgid "Collecting data..."
msgstr "Сбор данных..."

msgid "Log is empty"
msgstr "Журнал пуст"

msgid "Unable to read the log:"
msgstr "Не удалось прочитать журнал:"

msgid "The last 400 lines the system log holds for this tunnel, newest last."
msgstr "Последние 400 строк системного журнала для этого туннеля, новые снизу."

msgid "Refresh"
msgstr "Обновить"
