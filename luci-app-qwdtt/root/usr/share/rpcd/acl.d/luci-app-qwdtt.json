{
	"luci-app-qwdtt": {
		"description": "View qWDTT status and logs, and manage its configuration",
		"read": {
			"ubus": {
				"file": [ "exec" ]
			},
			"file": {
				"/usr/bin/qwdtt-luci": [ "exec" ]
			},
			"uci": [ "qwdtt" ]
		},
		"write": {
			"ubus": {
				"file": [ "exec" ]
			},
			"file": {
				"/usr/bin/qwdtt-luci-act": [ "exec" ]
			},
			"uci": [ "qwdtt" ]
		}
	}
}
