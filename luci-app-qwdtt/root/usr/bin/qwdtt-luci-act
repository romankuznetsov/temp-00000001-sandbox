#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Action half of the LuCI page at Services -> qWDTT. See qwdtt-luci for why
# this is a separate script: rpcd grants exec on a path, not on a verb, so
# keeping the state-changing verbs here lets the ACL put them under "write"
# while status and logs stay readable under "read".
#
# The verb list is enforced here, not in the ACL, and the section name is
# checked against /etc/config/qwdtt before it is passed on. Passing arbitrary
# arguments through to qwdtt would hand the browser every subcommand it has.
#
# Runtime only: none of these writes a section's enabled flag, so a tunnel
# stopped here comes back after a reboot. That flag is a setting like any
# other and is edited in the page's form.

set -eu

CTL=/usr/bin/qwdtt

# /usr/bin/qwdtt comes from the sibling 'qwdtt' package, which this one
# depends on. Checked anyway because a dependency can be force-removed, and
# said plainly rather than failing with a bare "not found", because the page
# surfaces this text to the operator.
require_ctl() {
	[ -x "$CTL" ] || {
		echo "$CTL is missing. It comes from the 'qwdtt' package, which" >&2
		echo "luci-app-qwdtt depends on: reinstall it, then retry." >&2
		exit 3
	}
}

VERB=${1:-}
SEC=${2:-}
SEL=
if [ -n "$SEC" ]; then
	[ "$(uci -q get "qwdtt.$SEC" || :)" = "qwdtt" ] || {
		echo "no section '$SEC' in /etc/config/qwdtt" >&2
		exit 4
	}
	SEL="-s $SEC"
fi

case "$VERB" in
start | stop | restart)
	require_ctl
	# Unquoted on purpose: empty must pass no argument at all.
	exec "$CTL" $SEL "$VERB" ;;
*)
	echo "usage: qwdtt-luci-act start|stop|restart [section]" >&2
	exit 2 ;;
esac
