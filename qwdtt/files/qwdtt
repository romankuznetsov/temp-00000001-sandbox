#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Control script for the qWDTT RAW-IP tunnels. Driven by the LuCI page at
# Services -> qWDTT and useful directly over ssh. A package of its own rather
# than part of luci-app-qwdtt: a headless router needs it with no web
# interface installed.
#
# /etc/config/qwdtt holds one section per tunnel and they run at the same time,
# so almost everything here takes a section. Without -s the verbs act on the
# service as a whole.
#
# A tunnel is a daemon-owned TUN device, not a netifd interface, so the service
# is what you start and stop. Adding a netifd interface made netifd flush the
# daemon's address and route.
#
# Client output goes to the system log, tagged qwdtt-<section> by the init
# script; read it with 'logread -e qwdtt'.

# Assumed, not provided: /etc/init.d/qwdtt, which start and stop delegate to,
# and qwdtt.<section>.enabled, which it reads to decide what starts at boot.
PROBE_HOSTS='8.8.8.8 1.1.1.1'
PROBE_COUNT=10                  # probes per host; loss matters, not reachability
PROBE_DEADLINE=4                # seconds; caps the probe against a dead host
MAX_LOSS=40                     # percent; above this the tunnel cannot carry TCP

usage() {
	echo "usage: qwdtt [-s section] start | stop | restart | status | brief | runtime | tunnel | log [n]" >&2
	echo "       without -s: every section for reports, the whole service for" >&2
	echo "       start, stop and restart." >&2
	echo "       Runtime only. What comes back after a reboot is the enabled" >&2
	echo "       flag of each section, which these never write." >&2
}

# Section names, in config order. uci restricts them to [A-Za-z0-9_], which is
# why they can be passed around unquoted and used as jsonfilter path elements.
sections() {
	uci -q show qwdtt | sed -n 's/^qwdtt\.\([^.=]*\)=qwdtt$/\1/p'
}

exists() {
	[ "$(uci -q get "qwdtt.$1")" = "qwdtt" ]
}

get() {
	local value
	value=$(uci -q get "qwdtt.$1.$2") || :
	[ -n "$value" ] || value=$3
	echo "$value"
}

# virt-shell runs its shell inside 'nsclient', where the tunnel interface does
# not exist, so the check below would call a healthy tunnel down.
in_other_netns() {
	[ -r /proc/1/ns/net ] || return 1
	[ "$(readlink /proc/self/ns/net 2>/dev/null)" != "$(readlink /proc/1/ns/net 2>/dev/null)" ]
}

# procd knows which instances it is supervising, and it is the only thing that
# does: every client process has the same name, so pgrep cannot tell two
# tunnels apart. Asked once and kept: the runtime report is polled once a
# second and reads this for every section.
SERVICES=
service_list() {
	[ -n "$SERVICES" ] || SERVICES=$(ubus -S call service list '{"name":"qwdtt"}' 2>/dev/null)
	printf '%s' "$SERVICES"
}

running() {
	[ "$(service_list | jsonfilter -q -e "@.qwdtt.instances.$1.running")" = "true" ]
}

instance_pid() {
	service_list | jsonfilter -q -e "@.qwdtt.instances.$1.pid"
}

# With nothing running the service is still listed, as {"qwdtt":{}}, so the
# instances key is what says whether procd has anything to stop.
supervising() {
	[ -n "$SECTION" ] && { running "$SECTION"; return; }
	[ -n "$(service_list | jsonfilter -q -e '@.qwdtt.instances')" ]
}

# The client's TUN device outlives it, so that a restart keeps the interface
# index a bound socket is pinned to and holds the traffic meanwhile instead of
# letting it out over the WAN. Stopping a tunnel is the one case where that is
# wrong: nothing is coming back to read the device, so it has to go, and its
# routes go with it. The rule that selects its table can stay - an empty table
# is a lookup that falls through to the next rule.
#
# tun_flags exists only on a TUN device, which is what keeps this from deleting
# an unrelated interface that happens to share a section's name.
drop_device() {
	[ -e "/sys/class/net/$1/tun_flags" ] || return 0
	ip link del "$1" 2>/dev/null
}

# Starting a disabled section does nothing at all - the init script skips it -
# and says so to nobody: rc.common returns procd's exit status rather than
# start_service's, so a refusal there cannot reach the caller. Said here
# instead, because the LuCI page reports only what fails and would otherwise
# show a spinner and no change.
refuse_disabled() {
	[ -n "$SECTION" ] || return 0
	[ "$(get "$SECTION" enabled 0)" = 1 ] && return 0
	echo "qwdtt: $SECTION is disabled; enable it first" >&2
	exit 3
}

# Seconds this pid has been alive. Field 22 of /proc/<pid>/stat is its start
# time in clock ticks since boot, and USER_HZ is 100 on every target OpenWrt
# builds for. Everything up to the closing parenthesis is dropped first: the
# command name sits in there and may contain spaces, which would shift the
# fields that follow.
#
# Shell builtins throughout, no awk or cut: this runs for every section on
# every poll, and the page polls once a second.
process_uptime() {
	local line ticks now

	read -r now _ < /proc/uptime || { echo 0; return; }
	now=${now%%.*}
	read -r line < "/proc/$1/stat" 2>/dev/null || { echo 0; return; }
	line=${line#*") "}
	# shellcheck disable=SC2086 # deliberate split into positional parameters
	set -- $line
	ticks=${20}
	echo $((now - ticks / 100))
}

human() {
	awk -v b="$1" 'BEGIN {
		split("B KB MB GB TB", u, " ")
		i = 1
		while (b >= 1024 && i < 5) { b /= 1024; i++ }
		printf (i == 1 ? "%d %s" : "%.2f %s"), b, u[i]
	}'
}

format_uptime() {
	awk -v s="$1" 'BEGIN {
		d = int(s / 86400); s %= 86400
		h = int(s / 3600); s %= 3600
		m = int(s / 60); s %= 60
		if (d) printf "%dd %dh", d, h
		else if (h) printf "%dh %dm", h, m
		else if (m) printf "%dm %ds", m, s
		else printf "%ds", s
	}'
}

# $2 is packets or bytes, $3 is rx or tx.
counter() {
	local n=0 file=/sys/class/net/$1/statistics/$3_$2

	[ ! -r "$file" ] || read -r n < "$file"
	echo "$n"
}

# Empty for a TUN, which has no link layer, so the page can leave the line out.
mac_of() {
	local mac= file=/sys/class/net/$1/address

	[ ! -r "$file" ] || read -r mac < "$file"
	[ "$mac" = 00:00:00:00:00:00 ] && mac=
	echo "$mac"
}

# The one thing here that needs a fork: sysfs carries no addresses.
ipv4_of() {
	local out

	out=$(ip -4 -o addr show dev "$1" 2>/dev/null) || return 0
	# shellcheck disable=SC2086 # deliberate split into positional parameters
	set -- $out
	while [ $# -gt 0 ]; do
		[ "$1" = inet ] && { echo "$2"; return 0; }
		shift
	done
}

# The client creates its TUN only once the server has answered, so a running
# process is not a working tunnel. Carrier is the field that means something
# for a userspace TUN: the operational state reads "unknown" however well it
# is working.
device_up() {
	local carrier

	[ -e "/sys/class/net/$1" ] || return 1
	read -r carrier < "/sys/class/net/$1/carrier" 2>/dev/null || return 1
	[ "$carrier" = 1 ]
}

# Why a tunnel that should be up is not carrying anything. Empty when there is
# nothing to say, including while a tunnel is still connecting - that is what
# the page reports instead of an error. The log is only read in the broken
# case: it is the one thing here that scans the whole ring buffer, and this
# runs once a second.
trouble() {
	local sec=$1 pid=$2 last

	if [ -z "$pid" ]; then
		[ "$(get "$sec" enabled 0)" = 1 ] || return 0
		last=$(logread -e "qwdtt\.$sec:" 2>/dev/null | tail -1)
		[ -n "$last" ] || { echo "enabled, but not running"; return 0; }
		echo "${last#*qwdtt.$sec: }"
	elif [ -e "/sys/class/net/$sec" ] && ! device_up "$sec"; then
		echo "$sec is present but has no carrier"
	fi
}

# Loss rather than one packet: with only some workers stale the tunnel still
# answers intermittently, and a single ping calls that healthy. The awk reads
# the loss percentage, not the received count, whose field ends in a comma and
# parsed as 0. -I takes the DEVICE; with an address the packet still leaves by
# the default route and never enters the tunnel. -A because BusyBox ping has
# whole-second intervals only.
tunnel_ok() {
	local tun=$1 h loss

	for h in $PROBE_HOSTS; do
		loss=$(ping -c"$PROBE_COUNT" -A -w"$PROBE_DEADLINE" -I "$tun" "$h" 2>/dev/null |
			awk '{ for (i = 1; i <= NF; i++) if ($i ~ /%$/) { sub(/%$/, "", $i); print $i; exit } }')
		loss=${loss%%.*}
		[ -n "$loss" ] || loss=100
		TUNNEL_RESULT="${loss}% loss via $h"
		[ "$loss" -le "$MAX_LOSS" ] && return 0
	done
	return 1
}

# Everything readable without sending a packet, so the LuCI page can poll it
# through `qwdtt brief`. One implementation on purpose: this was once copied
# into the page's rpcd helper and the two drifted.
report_static() {
	local sec=$1 table mark ph pp pid

	table=$(get "$sec" route_table 51820)
	mark=$(get "$sec" fwmark '')

	echo "section:   $sec"
	echo "enabled:   $(get "$sec" enabled '?')"
	if [ -e "/sys/class/net/$sec" ]; then
		if device_up "$sec"; then
			echo "interface: $sec up, carrier ok"
		else
			echo "interface: $sec present but NO CARRIER"
		fi
		echo "address:   $(ip -4 -o addr show "$sec" 2>/dev/null | awk '{printf "%s ", $4}')"
		echo "route:     $(ip route show table "$table" 2>/dev/null | head -1)"
	elif in_other_netns; then
		echo "interface: not visible from this network namespace"
		echo "           ($sec lives in the root namespace; the tunnel may be fine)"
	else
		echo "interface: down ($sec absent)"
	fi
	if [ -n "$mark" ]; then
		echo "selects:   packets marked $mark"
	else
		echo "selects:   everything arriving from the LAN"
	fi
	pid=$(instance_pid "$sec")
	if [ -n "$pid" ]; then
		echo "running:   yes, for $(format_uptime "$(process_uptime "$pid")")"
	else
		echo "running:   no"
	fi
	# The device's own counters, not the client's: the client used to print a
	# [STATS] line every three seconds and no longer does, and these count what
	# actually crossed the interface. They survive a restart, because the device
	# does, and go to zero only when the tunnel is stopped and the device with
	# it.
	echo "rx:        $(human "$(counter "$sec" bytes rx)") ($(counter "$sec" packets rx) packets)"
	echo "tx:        $(human "$(counter "$sec" bytes tx)") ($(counter "$sec" packets tx) packets)"
	ph=$(get "$sec" peer_host '')
	pp=$(get "$sec" peer_port '')
	echo "peer:      ${ph}${pp:+:$pp}"
	echo "hashes:    $(uci -q get "qwdtt.$sec.hash" | wc -w) configured"
	echo "log:       logread -e qwdtt-$sec"
}

# What the LuCI table polls: every section in one object, so a page with six
# tunnels still makes one call. Section names are [A-Za-z0-9_] by uci's own
# rule and the values are numbers, so nothing here needs escaping.
report_runtime() {
	local sec pid up err first=1 isup=false
	local rxp=0 txp=0 rxb=0 txb=0 ipv4= mac=

	printf '{'
	for sec in $TARGETS; do
		[ "$first" = 1 ] || printf ','
		first=0
		pid=$(instance_pid "$sec")
		up=0
		isup=false
		rxp=0 txp=0 rxb=0 txb=0 ipv4= mac=

		# Only once the tunnel is actually up. A running process whose device
		# has not appeared has nothing to report: the counters would be zeroes
		# and the uptime would be the process's, not the tunnel's. A stopped
		# section names a device it does not own, so its counters are not even
		# its own.
		if [ -n "$pid" ] && device_up "$sec"; then
			isup=true
			up=$(process_uptime "$pid")
			rxp=$(counter "$sec" packets rx)
			txp=$(counter "$sec" packets tx)
			rxb=$(counter "$sec" bytes rx)
			txb=$(counter "$sec" bytes tx)
			ipv4=$(ipv4_of "$sec")
			mac=$(mac_of "$sec")
		fi

		# Quotes and backslashes would break the JSON, and the only free text
		# here is a log line.
		err=$(trouble "$sec" "$pid" | tr -d '\\"')
		printf '"%s":{"running":%s,"up":%s,"uptime":%s,"rx":%s,"tx":%s,"rx_bytes":%s,"tx_bytes":%s,"ipv4":"%s","mac":"%s","error":"%s"}' \
			"$sec" "$([ -n "$pid" ] && echo true || echo false)" "$isup" \
			"${up:-0}" "$rxp" "$txp" "$rxb" "$txb" "$ipv4" "$mac" "$err"
	done
	printf '}\n'
}

# The end-to-end probe alone, so the page's button can show its result instead
# of repeating the whole status underneath the copy it already polls.
report_tunnel() {
	local sec=$1

	if tunnel_ok "$sec"; then
		echo "tunnel:    $sec ok ($TUNNEL_RESULT)"
	else
		echo "tunnel:    $sec DEAD ($TUNNEL_RESULT)"
	fi
}

SECTION=
while [ $# -gt 0 ]; do
	case "$1" in
	-s)
		SECTION=$2
		[ -n "$SECTION" ] || { usage; exit 2; }
		exists "$SECTION" || {
			echo "qwdtt: no section '$SECTION' in /etc/config/qwdtt" >&2
			exit 2
		}
		shift 2 ;;
	*)
		break ;;
	esac
done

TARGETS=${SECTION:-$(sections)}

case "${1:-status}" in
start)
	refuse_disabled
	# start, not restart: procd's restart stops first, and stopping an
	# unregistered service prints a ubus error the page shows as a failure.
	# $SECTION unquoted on purpose here and below: empty must pass no
	# argument at all, which is how the init script is told to take them all.
	/etc/init.d/qwdtt start $SECTION &&
		echo "qwdtt: started ${SECTION:-all enabled sections}"
	;;
stop)
	# procd answers "Not found" when asked to delete an instance it does not
	# have, and that reads as a failed stop on the LuCI page.
	if supervising; then
		/etc/init.d/qwdtt stop $SECTION &&
			echo "qwdtt: stopped ${SECTION:-every section}"
	else
		echo "qwdtt: ${SECTION:-nothing} is already stopped"
	fi
	for sec in $TARGETS; do
		drop_device "$sec"
	done
	;;
restart)
	refuse_disabled
	# Same reason: procd's restart deletes before it starts, so restarting
	# something that is not running fails on the delete and then starts it
	# anyway, reporting an error for work that succeeded.
	if supervising; then
		/etc/init.d/qwdtt restart $SECTION &&
			echo "qwdtt: restarted ${SECTION:-every section}"
	else
		/etc/init.d/qwdtt start $SECTION &&
			echo "qwdtt: started ${SECTION:-all enabled sections}"
	fi
	;;
status)
	for sec in $TARGETS; do
		report_static "$sec"
		report_tunnel "$sec"
		echo "--- recent log ---"
		logread -e "qwdtt-$sec" 2>/dev/null | grep -avi DEBUG | tail -8
		echo
	done
	;;
brief)
	for sec in $TARGETS; do
		report_static "$sec"
		echo
	done
	;;
runtime)
	report_runtime ;;
tunnel)
	for sec in $TARGETS; do
		report_tunnel "$sec"
	done
	;;
log)
	logread -e "qwdtt${SECTION:+-$SECTION}" 2>/dev/null | tail -n "${2:-50}"
	;;
*)
	usage
	exit 1
	;;
esac
