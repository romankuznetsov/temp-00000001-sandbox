# One section per tunnel, all running at once. The section name is the TUN
# device the client creates, so it has to be a valid interface name - and
# keeping the qwdtt prefix is what puts it in the firewall zone below, which
# matches qwdtt+. A second tunnel needs its own route_table and an fwmark to
# say which traffic it carries; the section without one takes everything
# arriving from the LAN.
config qwdtt 'qwdtt0'
	option enabled '0'
	option mode 'rawtun'
	option route_table '51820'
	option rule_priority '10000'
	option workers '9'
	option dns 'yandex'
	option obfs 'audio'
	option captcha_mode 'auto'
	option vk_auth 'anonymous'
	option vk_anon_path 'vkcalls'
	option no_dtls '0'
	option turn_tcp '0'
