# One section per tunnel, all running at once. A second section needs its own
# tun_name and route_table, and an fwmark to say which traffic it carries -
# the section without one takes everything arriving from the LAN.
config qwdtt 'main'
	option enabled '0'
	option mode 'rawtun'
	option tun_name 'qwdtt0'
	option workers '9'
	option dns 'yandex'
	option obfs 'audio'
	option captcha_mode 'auto'
	option vk_auth 'anonymous'
	option vk_anon_path 'vkcalls'
	option no_dtls '0'
	option turn_tcp '0'
